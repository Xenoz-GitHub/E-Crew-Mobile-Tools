<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_title"
            android:textColor="@color/ecrew_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_privacy_note"
            android:textColor="@color/ecrew_text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/status_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/ecrew_text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/status_code_label"
            android:textColor="@color/ecrew_text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/status_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.25"
            android:textColor="@color/ecrew_cyan"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/status_listening_label"
            android:textColor="@color/ecrew_text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/status_listening"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="@color/ecrew_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/ecrew_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/status_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/ecrew_error"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/start_button"
            style="@style/EcrewPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/status_start" />

        <Button
            android:id="@+id/stop_button"
            style="@style/EcrewSecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_stop"
            android:visibility="gone" />

        <Button
            android:id="@+id/new_code_button"
            style="@style/EcrewSecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_new_code" />

        <Button
            android:id="@+id/access_button"
            style="@style/EcrewSecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_accessibility_settings" />

        <Button
            android:id="@+id/end_session_button"
            style="@style/EcrewDangerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_end_session"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
