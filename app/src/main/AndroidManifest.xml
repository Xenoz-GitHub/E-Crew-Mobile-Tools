<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Local sockets / LAN recon / packet capture (no external traffic) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Wi-Fi scanning / wardriving (location required for scan results on API 26+) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- QR scanning -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Forensic acquisition -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Telephony permissions imply telephony hardware; keep the toolkit installable on
         Wi-Fi-only and large-screen devices. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Security audit: biometric enrollment state (normal permission) and the DUMP grant the
         operator applies once over ADB for the ADB tier (PACKAGE_USAGE_STATS is above). -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />

    <!-- Security audit, Shizuku tier (design note section 9c): the manager-defined permission
         the operator grants through the Shizuku app; E-Crew never auto-grants it. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Needed for foreground packet-capture notification when running as targetSdk 28 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Full installed-app enumeration for the APK analysis module (sideloaded tool) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Games Hub packs are installed from app assets on first play. Android 8+ still
         requires the user to enable this app as an install source and confirm the prompt. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Remote Support controller: Bluetooth RFCOMM to the agent. Legacy permissions cover
         API 26-30 with targetSdk 28; the modern pair is declared for 31+ devices. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- mDNS discovery of _ecrew-remote._tcp agents (MulticastLock) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Audit export into public Downloads on API 26-28 only; MediaStore is used on 29+. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.ForensicToolkit">

        <activity
            android:name="com.ecrew.toolkit.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ForensicToolkit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- APK analysis intake: a picked/shared APK opens the static workbench after a
                 capped copy into the app cache. No package is installed. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
        </activity>

        <!-- ZXing capture activity is declared by zxing-android-embedded itself
             (theme @style/zxing_CaptureTheme); do not redeclare. -->

        <!-- Local loopback VPN for packet capture (no external VPN server) -->
        <service
            android:name="com.ecrew.toolkit.service.PacketCaptureService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Peer messaging (Component 11): LAN + Bluetooth chat. Started by the visibility
             toggle (foreground) or while the Chat screen is open; no external traffic. -->
        <service
            android:name="com.ecrew.toolkit.messaging.MessagingService"
            android:exported="false" />

        <!-- Receives PackageInstaller status for bundled Games Hub packs. The receiver is
             process-local: the system delivers it through the session's PendingIntent. -->
        <receiver
            android:name="com.ecrew.toolkit.games.GamePackInstallReceiver"
            android:exported="false" />

        <!-- Component 14: foreground loopback interception proxy. No VPN or external
             listener; the Shizuku proxy toggle is a separate user service. -->
        <service
            android:name="com.ecrew.toolkit.intercept.InterceptionProxyService"
            android:exported="false" />

        <!-- Remote Support: grants the Bluetooth share app read access to the extracted
             agent APK (Send Agent screen). Authority is applicationId + .fileprovider. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.ecrew.toolkit.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Security audit, Shizuku tier (design note section 9c): how the Shizuku manager
             reaches the app to deliver the service binder. Guarded by the system permission
             required by the upstream Shizuku API; authority is applicationId + .shizuku. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.ecrew.toolkit.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
